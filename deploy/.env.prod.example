# 이 파일을 서버에서 .env.prod 로 복사해 실제 값을 채운다.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# ⚠️ .env.prod 는 절대 커밋하지 않는다 (deploy/.gitignore 에 등록되어 있음).
# ⚠️ 값에 따옴표를 붙이지 말 것 — docker compose 는 따옴표까지 값으로 읽는다.

# ── DB ───────────────────────────────────────────────
POSTGRES_DB=bitpet
POSTGRES_USER=bitpet
# openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────
# openssl rand -base64 24
REDIS_PASSWORD=

# ── 보안 키 ──────────────────────────────────────────
# HS256 서명용. 최소 32바이트.  openssl rand -base64 48
BITPET_JWT_SECRET=
# OAuth 토큰 AES-256-GCM 암호화용. 정확히 32바이트를 base64 로.  openssl rand -base64 32
BITPET_TOKEN_ENC_KEY=

# ── S3 (실제 AWS) ────────────────────────────────────
# LocalStack 이 아니므로 path-style 은 compose 에서 false 로 고정되어 있다.
BITPET_S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
BITPET_S3_REGION=ap-northeast-2
BITPET_S3_BUCKET=
BITPET_S3_ACCESS_KEY=
BITPET_S3_SECRET_KEY=

# ── 메일 ─────────────────────────────────────────────
MAIL_FROM=noreply@tailog.me
MAIL_USERNAME=
# Gmail 은 앱 비밀번호(2단계 인증 필요). 계정 비밀번호가 아니다.
MAIL_PASSWORD=

# ── NFC 딥링크 (App Links) ───────────────────────────
# 업로드 키 지문과 Play 앱 서명 키 지문을 콤마로 둘 다 넣는다.
# 업로드 키(2026-08-15 확인): 21:BF:4F:88:84:6E:22:E3:69:58:5A:78:A3:CD:04:65:41:AB:9C:35:C9:9B:FE:DB:DF:ED:83:BB:36:EA:B3:5B
# Play 앱 서명 키는 AAB 를 처음 올린 뒤 Play Console > 설정 > 앱 서명 에서 확인해 추가한다.
BITPET_ANDROID_SHA256=

# ── FCM ──────────────────────────────────────────────
# 서비스 계정 키는 deploy/secrets/firebase-service-account.json 에 둔다 (compose 가 마운트).
# 키가 없으면 false 로. 푸시만 꺼지고 서버는 정상 기동한다.
BITPET_FCM_ENABLED=true
