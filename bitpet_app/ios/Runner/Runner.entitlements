<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple 로그인. App ID 에 'Sign in with Apple' 기능이 켜져 있어야 서명된다 -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- NFC 이름표 읽기 (NDEF URL 만). App ID 에 'NFC Tag Reading' 필요 -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- 유니버설 링크 — https://tailog.me/t/{tagCd} 를 앱이 연다.
	     서버 /.well-known/apple-app-site-association 과 짝. App ID 에 'Associated Domains' 필요 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tailog.me</string>
	</array>
	<!-- 푸시 (APNs). 업로드 프로파일이 production 으로 바꿔 서명한다 -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
