<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9(API 28)부터 평문(http) 통신은 기본 차단이다.
  운영은 https://tailog.me 이므로 문제가 없지만, 로컬 개발 서버는 http 라서
  아무 설정이 없으면 `flutter run --release` + adb reverse 로 실기기 검증을 할 수 없다.

  그래서 예외를 로컬 주소 두 개로만 연다. 기본값(cleartextTrafficPermitted="false")은
  그대로 두므로 tailog.me 를 포함한 나머지 전부는 여전히 https 강제다.
  `usesCleartextTraffic="true"` 로 전체를 열지 않는 이유가 이것이다.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- adb reverse tcp:8080 tcp:8080 -->
        <domain includeSubdomains="false">localhost</domain>
        <!-- 안드로이드 에뮬레이터에서 본 호스트 PC -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
